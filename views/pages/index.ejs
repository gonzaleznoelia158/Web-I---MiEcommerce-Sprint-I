      <%# BANNER PUBLICITARIO %>
        <section class="banner">
          <div class="banner-card">
            <img src="/img/index/Banner disney.png" alt="Disney Plus">
          
            <div class="texto-encima">
              <h3>¡50% OFF!</h3>
              <p>Canjea a partir de 50.000 puntos <br> y gana descuentos exclusivos<br>en Disney+</p>
            </div>
          </div>

          <div class="banner-card">
            <img src="/img/index/bannerhbo.png" alt="HBO Max">
          
            <div class="texto-encima">
              <h3>¡1 mes GRATIS!</h3>
              <p>Canjea a partir de 30.000 puntos <br>y obtene 1 mes de HBO Max sin cargo</p>
            </div>
          </div>
        </section>

      <%# CONTENEDOR DE ICONOS %>
      <%- include('../partials/secciones') %>

        <%# SECCION DE PRODUCTOS %>

      <h3 class="titulo-productos">Tambien podria interesarte</h3>

      <div class="ordenar">
        <label for="ordenar">Ordenar por:</label>
        <div class="select">
          <select id="ordenar" name="ordenar">
            <option value="/" <%= sort ==='asc'? 'selected' : '' %>>Sin orden</option>
            <option value="/?sort=asc" <%= sort === 'asc' ? 'selected' : '' %>>Menor precio</option>
            <option value="/?sort=desc" <%= sort === 'desc' ? 'selected' : '' %>>Mayor precio</option>
          </select>
        </div>
      </div>

      <%# Scripts de ordenamiento %>
      <script>
      const select = document.getElementById('ordenar');
      select.addEventListener('change', function() {
        window.location.href = this.value;
        });
      </script>


      <div class="productos-grid">
  <% products.forEach(product => { %>
    <section class="caja-producto">
      <div class="producto">
        <a href="/products/<%= product.id %>">
        <img src="<%= product.imagen %>" alt="<%= product.nombre %>">
      </div>
        <div class="descripcion">
          <div class="nombre">
            <h4><%= product.nombre %></h4>
          </div>
          <div class="puntos-producto">
            <span class="cantidad-puntos"><%= product.precio %></span>
            <span class="puntos">$</span>
>>>>>>> ramita
          </div>
        </div>
      </a>
    </section>
  <% }); %>
</div>
      
