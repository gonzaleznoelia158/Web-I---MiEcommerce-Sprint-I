<link rel="stylesheet" href="/css/index.css">

<%# SECCIÓN: PRODUCTOS SUGERIDOS %>
<section class="seccion-productos">
    <h2 class="titulo-productos">Productos sugeridos</h2>
    <div class="productos-grid">
        <% suggestedProducts.forEach(product => { %>
            <%- include('../partials/productCard', { product: product }) %>
        <% }) %>
    </div>
</section>

<%# SECCIÓN: TODOS LOS PRODUCTOS %>
<section class="seccion-productos">
    <h2 class="titulo-productos">Todos los productos</h2>

    <div class="ordenar">
        <label for="ordenar">Ordenar por:</label>
        <div class="select">
            <select id="ordenar" name="ordenar">
                <option value="/">Sin orden</option>
                <option value="/?sort=asc" <%= sort === 'asc' ? 'selected' : '' %>>Menor precio</option>
                <option value="/?sort=desc" <%= sort === 'desc' ? 'selected' : '' %>>Mayor precio</option>
            </select>
        </div>
    </div>

    <div class="productos-grid">
        <% products.forEach(product => { %>
            <%- include('../partials/productCard', { product: product }) %>
        <% }) %>
    </div>
</section>

<script>
    const select = document.getElementById('ordenar');
    select.addEventListener('change', function () {
        window.location.href = this.value;
    });
</script>