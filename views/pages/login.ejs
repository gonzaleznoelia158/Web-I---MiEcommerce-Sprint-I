<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
<main>
    
    <form action="/login" method="POST">
        <p>Iniciar Sesión</p>
        
        <input type="text" id="correo" name="correo" placeholder="Email" required>
        <p class="error-msg" id="err-correo"></p>
        <input type="password" id="password" name="password" placeholder="Contraseña" required>
        <p class="error-msg" id="err-password"></p>
        <button type="submit" id="submit-btn" disabled>Iniciar Sesión</button>

        <p>¿No tienes cuenta? <a href="/register">Registrate</a></p>
    </form>
</main>

<script src="/js/validLogin.js"></script>
</body>
</html>