<!DOCTYPE html>
<html lang="es">
<link rel="stylesheet" href="/css/register.css">
    
<head>
    <meta charset="UTF-3">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro</title>
    <link rel="stylesheet" href="/css/register.css">

</head>
<body>
    <header>
        <p><b>Mi</b>Ecommerce</p>
    </header>
    <main>
        <form action="/login" method="GET">
            <p>Crear cuenta</p>
            <input type="text" id="username" name="username" required placeholder="Juan">
            <br>
            <input type="text" id="lastname" name="lastname" required placeholder="Lopez">
            <br>
            <input type="email" id="email" name="email" required placeholder="ejemplo@correo.com">
            <br>
            <input type="password" id="password" name="password" required placeholder="********">
            <br>
            <button type="submit" >Registrar</button>
            <p>¿Ya tienes cuenta? <a href="/login">Iniciar Sesión</a></p>
            
             <ul class="req-list" id="req-list">
             <li id="r-len"><i class="ti ti-circle"></i> Mín. 8 caracteres</li>
             <li id="r-letter"><i class="ti ti-circle"></i> Al menos una letra</li>
             <li id="r-num"><i class="ti ti-circle"></i> Al menos un número</li>
             <li id="r-special"><i class="ti ti-circle"></i> Carácter especial</li>
             <li id="r-noban"><i class="ti ti-circle"></i> Sin cadenas prohibidas</li>
             <li id="r-noemail"><i class="ti ti-circle"></i> No igual al email</li>
             </ul>
             <p class="error-msg" id="err-password"></p>
        </form>
    </main>
</body>
</html>