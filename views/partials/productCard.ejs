<% const imageToShow = product.imagen ? product.imagen : '/img/default-fallback.jpg'; %>

<section class="caja-producto">
    <a href="/products/<%= product.id %>" style="text-decoration: none; color: inherit;">
        <div class="producto">
            <img src="<%= imageToShow %>" alt="<%= product.nombre %>">
        </div>
        <div class="descripcion">
            <div class="nombre">
                <h4><%= product.nombre %></h4>
                <% if (product.stock !== undefined && product.stock === 0) { %>
                    <span class="badge-sin-stock">Sin stock</span>
                <% } %>
            </div>
            <div class="puntos-producto">
                <span class="cantidad-puntos"><%= product.precio %></span>
                <span class="puntos">$</span>
            </div>
        </div>
    </a>
</section>