<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/footer.css">
<%# Font Awesome para íconos de redes sociales %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/social-icons.css">
<link rel="stylesheet" href="/css/index.css">
<link rel="stylesheet" href="/css/checkout.css">


<header class="main-header">
  <div class="header-container">

    <div class="left">
       <nav class="nav">
      <a href="/" class="logo">
        <img src="/img/index/logome.png" alt="Logo" title="Inicio">
      </a>
      </nav>
    </div>

    <div class="center">
      <form action="/search" method="GET" class="form-buscar"> 
      <input type="text" name="q" placeholder="Buscar productos..." class="buscar">
      <button class="btn-buscar" type="submit"><i class="fas fa-search"></i></button>
    </form>
    </div>

    <div class="auth">
      <a href="/products/cart" class="carrito"><i class="fas fa-shopping-cart">
        <% if (cartCont > 0){ %>
          <span class="contador"><%= cartCont %></span>
        <% } %>
      </i></a>
      <hr>
      <a href="/login">Login</a>
      <span>/</span>
      <a href="/register">Register</a>
    </div>
  </div>
</header>